{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noor-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noor-invitations",
      "database_id": "95354800-7109-4e13-a21b-f13b2805192e"
    }
  ]
}
